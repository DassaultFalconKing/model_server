                      "curl_response",
                      "binary",
                      "diff"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "authority": {
                    "type": "string",
                    "enum": [
                      "local_exact_head",
                      "hosted_exact_head",
                      "derived_runtime",
                      "unverified"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "authority"
                ]
              }
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_RUN",
                      "BLOCKED"
                    ]
                  },
                  "evidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "status",
                  "evidence"
                ]
              }
            }
          },
          "required": [
            "repository",
            "commit_sha",
            "verdict",
            "artifacts",
            "gates"
          ]
        }
      }
    }
  ],
